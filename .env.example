OPENAI_API_KEY="Put your Open AI key here!"

# Everything else is optional. Durable state for the spend cap, rate limiter and
# reading cache (UPSTASH_REDIS_REST_URL/_TOKEN, or Vercel's KV_REST_API_* names)
# and the PF_* budget knobs are documented in AGENTS.md; with none of them set
# the store falls back to per-instance memory, which is fine for `npm run dev`.

# Optional, and only for reaching protected preview deployments. Created by the
# repo owner in the Vercel dashboard; `npm run preview` and docs/preview-access.md
# cover the rest. Keep the real value in .env.local, which is gitignored.
VERCEL_AUTOMATION_BYPASS_SECRET=""
